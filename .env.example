# DeepEval + DeepSeek 配置
# 复制本文件为 .env 并填入真实密钥：cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到仓库

# 启用 DeepSeek 作为评测用的 LLM provider
USE_DEEPSEEK_MODEL=true

# DeepSeek API Key（必填）
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 模型名（可选，默认 deepseek-chat）
# 可选值：deepseek-chat / deepseek-v3.2 / deepseek-v3.1 / deepseek-reasoner
DEEPSEEK_MODEL_NAME=deepseek-chat

# 成本统计（可选，不填则使用 deepeval 内置默认值）
# DEEPSEEK_COST_PER_INPUT_TOKEN=0.000000028
# DEEPSEEK_COST_PER_OUTPUT_TOKEN=0.00000042
