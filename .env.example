# DeepEval + DeepSeek 配置
# 复制本文件为 .env 并填入真实密钥：cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到仓库

# 启用 DeepSeek 作为评测用的 LLM provider
USE_DEEPSEEK_MODEL=true

# DeepSeek API Key（必填）
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 模型名（可选，默认 deepseek-chat）
# 内置支持：deepseek-chat / deepseek-v3.2 / deepseek-v3.1 / deepseek-reasoner / deepseek-r1
# 也可填任意 DeepSeek API 支持的模型（如 deepseek-flash），但需手动指定 cost
DEEPSEEK_MODEL_NAME=deepseek-chat

# 成本统计
# - 使用内置模型时可省略（deepeval 自带定价）
# - 使用未注册模型（如 deepseek-flash）时必填，否则 cost 显示为 None
# deepseek-flash 参考定价（以 DeepSeek 官网为准）：
DEEPSEEK_COST_PER_INPUT_TOKEN=0.000000014
DEEPSEEK_COST_PER_OUTPUT_TOKEN=0.00000028
